# ==============================================================================
# SafeDose NearMiss - Environment Configuration
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Only variables prefixed with VITE_ are exposed to the client bundle by Vite.
# - NEVER put sensitive keys (such as SUPABASE_SERVICE_ROLE_KEY) in client code
#   or in any file prefixed with VITE_.
# - The Supabase anon public key is safe for browser distribution when PostgreSQL
#   Row Level Security (RLS) is properly configured on all tables.
# ==============================================================================

# Public Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Allow demo seeding script to run in production (defaults to false)
# ALLOW_DEMO_SEED=false

# Note: If VITE_SUPABASE_URL is not set or the remote instance is offline,
# SafeDose NearMiss operates in resilient local fallback mode with deterministic
# benchmark datasets and local browser storage.
